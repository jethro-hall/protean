# Protean — environment template. Copy to .env and fill. NEVER commit the real .env.
# Law 2/6: secrets come from here, are named, and are redacted in logs — never hardcoded.

# --- LLM providers (at least one) ---
# The Claude Agent SDK adapter is the reference. VERIFY exact env var names against current SDK docs.
ANTHROPIC_API_KEY=
# If routing Claude via AWS Bedrock (this environment reaches bedrock-runtime.ap-southeast-2):
AWS_REGION=ap-southeast-2
AWS_BEARER_TOKEN_BEDROCK=
# Optional additional providers (adapters behind the Gateway):
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Watcher / small fast model (Tier 1) ---
PROTEAN_FAST_MODEL=
PROTEAN_STRONG_MODEL=

# --- Runtime ---
PROTEAN_PORT=8787
PROTEAN_LOG_LEVEL=info
PROTEAN_CACHE_TTL_SECONDS=3600
