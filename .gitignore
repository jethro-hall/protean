# Secrets — NEVER commit (the one security rule that holds during the POC)
.env
.env.*
!.env.example
*.pem
*.key
**/secrets/**
**/credentials*.json
claude_desktop_config*.json

# Node / build
node_modules/
dist/
build/
.vite/
coverage/
*.log
.DS_Store

# Do NOT ignore APP/ARTEFACTS or APP/LLMBUILD_DATA — owner wants the full build data in the repo
# (only the secrets above are excluded).
# NOTE: a blanket `*.md` ignore was reverted 2026-07-27 — it silently blocked all future ADRs,
# BUILD_LOG session files, and READMEs (governance requires those committed). If specific markdown
# clutter must be ignored, add a targeted path here instead.

# Operational service logs (systemd units) — not build artefacts
APP/LLMBUILD_DATA/logs/
