{
  "name": "protean-gui",
  "version": "0.1.0",
  "private": true,
  "description": "Protean three-pane GUI shell — executive theme, streaming chat, live preview pane.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
