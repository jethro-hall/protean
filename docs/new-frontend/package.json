    "preview": "vite preview"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.0.4",
    "eslint": "^10.8.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vite": "8.1.5"
  }
}
