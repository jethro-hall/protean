# infra/.env.example — copy to infra/.env (gitignored) and fill in. NEVER commit infra/.env.
# Secrets only here or in a secret store; never baked into an image (the one POC security rule).

# --- Postgres (protean-pg) ---
PG_USER=protean
PG_PASSWORD=change-me
PG_DB=protean

# --- Redis (protean-cache) ---
# (no password in POC; add requirepass in redis.conf before any non-local exposure)

# --- pinned image tags (verify latest-stable at build time) ---
PG_IMAGE_TAG=pg16
REDIS_IMAGE_TAG=7-alpine
