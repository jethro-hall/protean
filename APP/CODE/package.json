{
  "name": "protean-code",
  "version": "0.1.0",
  "private": true,
  "description": "Protean backend engine — provider-agnostic agent core, LLM gateway, watcher, logging.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "spike": "tsx src/spike.ts",
    "bench": "tsx src/bench.ts",
    "eval": "tsx src/eval/runEval.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.220",
    "fflate": "^0.8.3",
    "pdf-parse": "^2.4.5",
    "pg": "^8.22.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/pg": "^8.20.3",
    "eslint": "^9",
    "tsx": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vitest": "^3"
  }
}
