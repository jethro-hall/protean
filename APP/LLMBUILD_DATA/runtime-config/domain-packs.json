        "schema_version": "\"1.0.0\"",
        "record_type": "\"professional_documentation_research\"",
        "generated_at": "\"{{generated_at_iso8601}}\"",
        "reference_date": "\"{{reference_date_yyyy_mm_dd}}\"",
        "request": "{\n  \"profession\": \"{{profession}}\",\n  \"alternate_titles\": [],\n  \"jurisdiction\": {\n    \"country\": \"{{country_name}}\",\n    \"country_code\": \"{{iso_3166_1_alpha2}}\",\n    \"subnational_unit\": \"{{state_province_or_region_or_null}}\",\n    \"subnational_code\": \"{{iso_3166_2_or_null}}\",\n    \"scope_note\": \"{{scope_note}}\"\n  },\n  \"language\": \"{{language}}\",\n  \"audience_level\": \"university\",\n  \"document_goal\": \"{{document_goal}}\",\n  \"research_mode\": \"trusted_sources_only\",\n  \"must_include_topics\": [],\n  \"must_exclude_topics\": [],\n  \"kb_taxonomy\": {\n    \"domain\": \"{{taxonomy_domain_or_null}}\",\n    \"discipline\": \"{{taxonomy_discipline_or_null}}\",\n    \"tags\": []\n  }\n}",
        "governance": "{\n  \"record_status\": \"verified\",\n  \"trusted_source_policy_passed\": true,\n  \"current_data_check_passed\": true,\n  \"data_cutoff_date\": \"{{reference_date_yyyy_mm_dd}}\",\n  \"freshness_assessment\": {\n    \"overall_recency\": \"current\",\n    \"oldest_material_source_date\": \"{{oldest_material_source_date_or_null}}\",\n    \"newest_material_source_date\": \"{{newest_material_source_date_or_null}}\",\n    \"staleness_warnings\": []\n  },\n  \"limitations\": [],\n  \"conflicts_detected\": [],\n  \"verification_notes\": []\n}",
        "profession_profile": "{\n  \"canonical_profession_name\": \"{{canonical_profession_name}}\",\n  \"profession_summary\": \"{{2_to_5_sentence_summary}}\",\n  \"role_definition\": \"{{official_or_source_grounded_definition}}\",\n  \"regulated_status\": \"licensed\",\n  \"practice_areas\": [],\n  \"regulators\": [\n    {\n      \"name\": \"{{regulator_name}}\",\n      \"jurisdiction\": \"{{jurisdiction_label}}\",\n      \"role\": \"{{regulatory_role}}\",\n      \"citation_ids\": [\n        \"SRC-001\"\n      ]\n    }\n  ],\n  \"professional_bodies\": [],\n  \"accreditation_bodies\": [],\n  \"university_pathways\": [\n    {\n      \"pathway_name\": \"{{pathway_name}}\",\n      \"credential_level\": \"{{degree_or_award_type}}\",\n      \"entry_requirements_summary\": \"{{entry_requirements_summary}}\",\n      \"duration\": \"{{duration_or_null}}\",\n      \"accreditation_required\": true,\n      \"official_pathway_note\": \"{{official_pathway_note}}\",\n      \"citation_ids\": [\n        \"SRC-002\"\n      ]\n    }\n  ],\n  \"licensing_or_registration\": [\n    {\n      \"stage_name\": \"{{stage_name}}\",\n      \"requirement_summary\": \"{{requirement_summary}}\",\n      \"issuing_body\": \"{{issuing_body}}\",\n      \"effective_date\": \"{{effective_date_or_null}}\",\n      \"citation_ids\": [\n        \"SRC-003\"\n      ]\n    }\n  ],\n  \"core_competencies\": [\n    {\n      \"competency\": \"{{competency_label}}\",\n      \"summary\": \"{{competency_summary}}\",\n      \"citation_ids\": [\n        \"SRC-004\"\n      ]\n    }\n  ],\n  \"ethical_and_legal_obligations\": [\n    {\n      \"obligation\": \"{{obligation_label}}\",\n      \"summary\": \"{{obligation_summary}}\",\n      \"citation_ids\": [\n        \"SRC-005\"\n      ]\n    }\n  ],\n  \"employment_outlook\": {\n    \"overview\": \"{{official_statistics_grounded_overview_or_null}}\",\n    \"official_statistics\": [\n      {\n        \"metric_name\": \"{{metric_name}}\",\n        \"metric_value\": \"{{metric_value}}\",\n        \"unit\": \"{{unit}}\",\n        \"reference_period\": \"{{reference_period}}\",\n        \"geography\": \"{{geography}}\",\n        \"citation_ids\": [\n          \"SRC-006\"\n        ]\n      }\n    ],\n    \"trend_note\": \"{{trend_note_or_null}}\",\n    \"caveats\": []\n  },\n  \"current_changes\": [\n    {\n      \"change_type\": \"{{policy_rule_standard_or_handbook_change}}\",\n      \"effective_date\": \"{{effective_date}}\",\n      \"change_summary\": \"{{change_summary}}\",\n      \"impact\": \"{{impact_summary}}\",\n      \"citation_ids\": [\n        \"SRC-007\"\n      ]\n    }\n  ],\n  \"jurisdiction_variations\": [\n    {\n      \"jurisdiction_label\": \"{{jurisdiction_label}}\",\n      \"variation_summary\": \"{{variation_summary}}\",\n      \"citation_ids\": [\n        \"SRC-008\"\n      ]\n    }\n  ]\n}",
        "knowledge_base_payload": "{\n  \"canonical_title\": \"{{profession}} in {{jurisdiction}}\",\n  \"short_description\": \"{{short_description}}\",\n  \"retrieval_keywords\": [],\n  \"agent_notes\": {\n    \"safe_to_answer_from_record_until\": \"{{safe_to_answer_until_date}}\",\n    \"escalation_triggers\": [],\n    \"follow_up_needed\": false\n  }\n}",
        "citations": "[\n  {\n    \"citation_id\": \"SRC-001\",\n    \"source_type\": \"government_website\",\n    \"title\": \"{{source_title}}\",\n    \"publisher\": \"{{publisher}}\",\n    \"url\": \"{{https_url}}\",\n    \"domain\": \"{{domain}}\",\n    \"jurisdiction\": \"{{jurisdiction_label}}\",\n    \"publication_date\": \"{{publication_date_or_null}}\",\n    \"last_updated_date\": \"{{last_updated_date_or_null}}\",\n    \"effective_date\": \"{{effective_date_or_null}}\",\n    \"accessed_date\": \"{{reference_date_yyyy_mm_dd}}\",\n    \"is_primary\": true,\n    \"trust_tier\": \"Tier 1 Primary Authority\",\n    \"locator\": \"{{page_section_clause_or_null}}\",\n    \"evidence_note\": \"{{short_supporting_note}}\"\n  }\n]"
